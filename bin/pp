#!/usr/bin/env bash
# pp: drive an Android phone through adb, with safety checks for a phone that a person also uses.
#   pp front                 exit 0 when the app is in front
#   pp open                  bring the app forward
#   pp texts                 list the visible texts
#   pp tap "label" [n]       tap a node by its text or description; n picks the n-th node with that label (only when the app is in front)
#   pp tapxy X Y             tap a position on the screen in use (the second display too)
#   pp wait "text" [secs]    wait until a text shows (default 20 s)
#   pp go "label" "text" [s] tap, then wait for a text
#   pp type "text"           put text into the focused field through the clipboard (no keyboard glitches)
#   pp key NAME              send a key: enter, back, del, paste
#   pp shot [file]           screenshot to a file (default $PP_OUT/shot.png), prints the path
#   pp swipe x1 y1 x2 y2     swipe, only when the app is in front
#   pp scroll down|up        scroll the list most of one screen (down shows what is below)
#   pp find "label" [n]      scroll down until a node with the label shows, at most n screens (default 8); then pp tap it
#   pp audit                 list targets under 48 dp and controls without a label (no image, no model)
#   pp compare A.png B.png   print the screen regions that differ
#   pp init                  add a short pp block to AGENTS.md and CLAUDE.md in this folder
#   pp display overlay|hidden|locked|off   work on a second display, so the phone screen stays free; off returns to the phone screen
#                            overlay: a small preview window floats over the phone screen. No extra download.
#                            hidden: no window at all. Needs node and downloads scrcpy-server (0.7 MB) once.
#                            hidden works while the phone is locked on Android 14+ (a virtual device). locked: that mode only.
#                            The display sleeps after PP_IDLE seconds (default 60) with no pp command, so the phone can doze; the next pp command wakes it.
#                            PP_IDLE=0 keeps it awake. pp display sleep|wake does it by hand.
#   pp locked                exit 0 when the phone is locked (the lock screen shows)
#   pp perf start|show       start: reset the frame stats of the app. show: frames, slow frames and frame times since start,
#                            plus the app's own log lines with the tag Perf (for example redraw counts of a debug build)
#   pp states [file]         shot of the screen in light, dark and 200% text, joined in one image; restores the settings
# With a display on, open, texts, tap, type, key, shot and swipe act on that display, not on the phone screen.
# Set PP_PKG to the app id (required). Every input command refuses to act when another app is in front.
PKG=${PP_PKG:?pp: set PP_PKG to the app id, for example PP_PKG=com.example.app}
HERE=$(dirname "$(readlink -f "$0")")
"$HERE/adb-ready" || exit 1
OUT=${PP_OUT:-${TMPDIR:-/tmp}/pp}
# Files that pp leaves on the phone (the screen dump) go here, not to the root of the shared storage.
PHONE_DIR=${PP_PHONE_DIR:-/sdcard/Download/ADB}
mkdir -p "$OUT"

# The second display: its id is in $OUT/display, and the id of SurfaceFlinger (for screencap) in $OUT/display.sf.
DISP=${PP_DISPLAY:-$(cat "$OUT/display" 2>/dev/null)}
SF=$(cat "$OUT/display.sf" 2>/dev/null)
INPUT="input"; [ -n "$DISP" ] && INPUT="input -d $DISP"
# The idle watchdog sleeps the display group (a flag file marks it). Any command that is not about the display wakes it
# and marks the use time. KEYCODE_WAKEUP on the display wakes its power group only, not the phone screen.
if [ -n "$DISP" ] && [ "$1" != display ]; then
  woke=$(adb shell "date +%s > /data/local/tmp/pp-last; if [ -e /data/local/tmp/pp-asleep ]; then rm -f /data/local/tmp/pp-asleep; input -d $DISP keyevent KEYCODE_WAKEUP; echo woke; fi" | tr -d '\r')
  [ "$woke" = woke ] && sleep 1
fi
front() {
  if [ -n "$DISP" ]; then
    # The top activity of that display: the lines between "Display #N" and the next display.
    adb shell dumpsys activity activities | awk -v d="$DISP" '/^Display #/ { on = ($2 == "#" d) } on && /topResumedActivity/ { print; exit }' | command grep -q "$PKG/"
  else adb shell dumpsys activity activities | command grep -q "topResumedActivity.*$PKG/"; fi
}
need_front() {
  front && return
  # A locked phone has nothing in front: say so, and name the way out.
  if [ -z "$DISP" ] && adb shell dumpsys window | command grep -q 'isKeyguardShowing=true'; then
    echo "pp: the phone is locked. Run pp display hidden: it works while the phone is locked." >&2; exit 11
  fi
  echo "pp: $PKG is not in front" >&2; exit 10
}
# The size of the screen in use (the second display when one is on): "W H".
size() {
  local d=""; [ -n "$DISP" ] && d="-d $DISP"
  adb shell wm size $d | tr -d '\r' | awk -F': ' '/size/ { s = $2 } END { sub("x", " ", s); print s }'
}
# One scroll in the middle of the screen, away from the top bar and the keyboard area.
scroll() {
  read -r w h <<< "$(size)"
  local x=$((w / 2)) lo=$((h * 70 / 100)) hi=$((h * 30 / 100))
  if [ "$1" = up ]; then adb shell $INPUT swipe $x $hi $x $lo 300; else adb shell $INPUT swipe $x $lo $x $hi 300; fi
}
dump() {
  adb shell "mkdir -p $PHONE_DIR; rm -f $PHONE_DIR/pp.xml"
  if [ -n "$DISP" ]; then
    # --display alone can return the phone screen. --windows lists every display: keep the block of ours.
    adb shell uiautomator dump --windows "$PHONE_DIR/pp.xml" >/dev/null 2>&1
    xml=$(adb shell cat "$PHONE_DIR/pp.xml" | python3 -c 'import re,sys; m = re.search(r"<display id=\"%s\">(.*?)</display>" % sys.argv[1], sys.stdin.read(), re.S); print(m.group(1) if m else "")' "$DISP")
    printf '%s' "$xml" | command grep -q "package=\"$PKG\"" || { echo "pp: display $DISP shows no node of $PKG" >&2; return 1; }
  else
    adb shell uiautomator dump "$PHONE_DIR/pp.xml" >/dev/null 2>&1
    xml=$(adb shell cat "$PHONE_DIR/pp.xml")
  fi
  printf '%s' "$xml"
}

cmd=$1; shift
case "$cmd" in
  front) front ;;
  locked) adb shell dumpsys window | command grep -q 'isKeyguardShowing=true' ;;
  open)
    if [ -n "$DISP" ]; then
      act=$(adb shell cmd package resolve-activity --brief -c android.intent.category.LAUNCHER "$PKG" | tail -1 | tr -d '\r')
      adb shell am start --display "$DISP" -n "$act" >/dev/null
    else adb shell monkey -p "$PKG" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1; fi ;;
  display)
    # overlay, hidden and locked reuse the display that is on: a second start would make a new display with a new id.
    case "$1" in overlay|hidden|locked)
      if [ -n "$DISP" ] && adb shell cmd display get-displays | command grep -q "Display id $DISP:"; then echo "display $DISP (already on)"; exit 0; fi ;;
    esac
    case "$1" in
      overlay)
        adb shell settings put global overlay_display_devices "${2:-1080x2400/420}"
        sleep 3
        id=$(adb shell cmd display get-displays | command grep -o 'Display id [0-9]*: DisplayInfo{"Overlay' | command grep -o '[0-9]*' | head -1)
        sf=$(adb shell dumpsys SurfaceFlinger --display-id | command grep Overlay | command grep -o '^Display [0-9]*' | command grep -o '[0-9]*')
        [ -n "$id" ] && [ -n "$sf" ] || { echo "pp: the overlay display did not start" >&2; exit 4; }
        echo "$id" > "$OUT/display"; echo "$sf" > "$OUT/display.sf"; echo "display $id" ;;
      hidden)
        # Android 14 and newer: the display of a virtual device, which keeps working while the phone is locked.
        # It costs nothing extra while the phone is awake. Older Android, or a failed start: scrcpy-server.
        if [ "$(adb shell getprop ro.build.version.sdk | tr -d '\r')" -ge 34 ] 2>/dev/null; then
          bash "$0" display locked "${2:-1080x2400/420}" && exit 0
          echo "pp: the locked display failed; trying scrcpy-server" >&2
        fi
        ver=${PP_SCRCPY_VERSION:-5.0.1}
        jar=${XDG_CACHE_HOME:-$HOME/.cache}/whiskerADB/scrcpy-server-$ver.jar
        if [ ! -s "$jar" ]; then
          mkdir -p "$(dirname "$jar")"
          curl -fsSL -o "$jar" "https://github.com/Genymobile/scrcpy/releases/download/v$ver/scrcpy-server-v$ver" || { rm -f "$jar"; echo "pp: could not download scrcpy-server" >&2; exit 4; }
        fi
        rm -f "$OUT/display" "$OUT/display.sf"
        nohup node "$HERE/../lib/hidden.js" "$jar" "${2:-1080x2400/420}" "$OUT" >"$OUT/hidden.log" 2>&1 &
        echo $! > "$OUT/hidden.pid"
        for _ in $(seq 40); do [ -s "$OUT/display" ] && { echo "display $(cat "$OUT/display")"; exit 0; }; sleep 1; done
        echo "pp: the hidden display did not start (see $OUT/hidden.log)" >&2; exit 4 ;;
      locked)
        # A display of a virtual device has its own display group and power group: the power button sleeps only the
        # phone screen. The virtual device needs a companion association of the shell with a device profile.
        mac=02:00:00:70:70:6c
        assoc() { adb shell cmd companiondevice list 0 | tr -d '\r' | command grep -i "com.android.shell.*$mac" | command grep -o 'mId=[0-9]*' | head -1 | cut -d= -f2; }
        id=$(assoc)
        if [ -z "$id" ]; then
          adb shell cmd companiondevice associate 0 com.android.shell "$mac" android.app.role.COMPANION_DEVICE_APP_STREAMING >/dev/null
          id=$(assoc)
        fi
        [ -n "$id" ] || { echo "pp: could not make the companion association" >&2; exit 4; }
        adb push "$HERE/../lib/locked/classes.dex" /data/local/tmp/pp-locked.dex >/dev/null 2>&1
        size=${2:-1080x2400/420}; w=${size%%x*}; rest=${size#*x}; h=${rest%%/*}; dpi=${size##*/}
        rm -f "$OUT/display" "$OUT/display.sf"
        # Flags 0x1449: public, own content only, touch, trusted, always unlocked.
        nohup adb shell "CLASSPATH=/data/local/tmp/pp-locked.dex exec app_process / LockedDisplay $id $w $h $dpi 1449" >"$OUT/locked.log" 2>&1 &
        echo $! > "$OUT/locked.pid"
        for _ in $(seq 30); do
          d=$(command grep -o '^display [0-9]*' "$OUT/locked.log" 2>/dev/null | command grep -o '[0-9]*')
          if [ -n "$d" ]; then
            sf=$(adb shell dumpsys SurfaceFlinger --display-id | command grep 'displayName="meowtty-vd"' | command grep -o '^Display [0-9]*' | command grep -o '[0-9]*' | head -1)
            [ -n "$sf" ] || { echo "pp: no SurfaceFlinger id for display $d" >&2; exit 4; }
            echo "$d" > "$OUT/display"; echo "$sf" > "$OUT/display.sf"
            # The watchdog runs on the phone, so no adb traffic keeps the phone awake. PP_IDLE=0: no watchdog.
            idle=${PP_IDLE:-60}
            if [ "$idle" -gt 0 ]; then
              # One watchdog only: end every older one first (each start used to leave one behind). The loop ends when its display is gone:
              # `cmd power sleep` for an id that no longer exists put the whole phone to sleep (the screen locked by itself).
              adb shell "pkill -f pp-idle.pid; rm -f /data/local/tmp/pp-asleep; date +%s > /data/local/tmp/pp-last; nohup sh -c 'echo \$\$ > /data/local/tmp/pp-idle.pid; while sleep 10; do cmd display get-displays | grep -q \"Display id $d:\" || exit 0; last=\$(cat /data/local/tmp/pp-last 2>/dev/null || echo 0); now=\$(date +%s); if [ \$((now - last)) -gt $idle ] && [ ! -e /data/local/tmp/pp-asleep ]; then cmd power sleep --display-id $d >/dev/null 2>&1; : > /data/local/tmp/pp-asleep; fi; done' >/dev/null 2>&1 &"
            fi
            echo "display $d"; exit 0
          fi
          sleep 1
        done
        echo "pp: the locked display did not start (see $OUT/locked.log)" >&2; exit 4 ;;
      off)
        [ -s "$OUT/hidden.pid" ] && kill "$(cat "$OUT/hidden.pid")" 2>/dev/null
        [ -s "$OUT/locked.pid" ] && kill "$(cat "$OUT/locked.pid")" 2>/dev/null
        # Without a terminal the device side does not end with adb: end it by name. The virtual device and its display go with it.
        adb shell pkill -f LockedDisplay 2>/dev/null
        adb shell 'pkill -f pp-idle.pid 2>/dev/null; rm -f /data/local/tmp/pp-idle.pid /data/local/tmp/pp-asleep /data/local/tmp/pp-last' 2>/dev/null
        rm -f "$OUT/locked.pid"
        adb shell settings delete global overlay_display_devices >/dev/null
        rm -f "$OUT/display" "$OUT/display.sf" "$OUT/hidden.pid" ;;
      sleep) [ -n "$DISP" ] || { echo "pp: no display is on" >&2; exit 1; }
        adb shell cmd display get-displays | command grep -q "Display id $DISP:" || { echo "pp: display $DISP is gone: not sleeping (it would sleep the phone)" >&2; exit 1; }
        adb shell "cmd power sleep --display-id $DISP >/dev/null 2>&1; : > /data/local/tmp/pp-asleep" ;;
      wake) [ -n "$DISP" ] || { echo "pp: no display is on" >&2; exit 1; }
        adb shell "date +%s > /data/local/tmp/pp-last; rm -f /data/local/tmp/pp-asleep; input -d $DISP keyevent KEYCODE_WAKEUP" ;;
      *) echo "pp: display overlay|hidden|locked|sleep|wake|off" >&2; exit 1 ;;
    esac ;;
  texts) dump | python3 "$HERE/../lib/find.py" texts ;;
  tap)
    need_front
    xy=$(dump | python3 "$HERE/../lib/find.py" tap "$1" "${2:-1}")
    [ -n "$xy" ] || { echo "pp: no node: $1${2:+ (number $2)}" >&2; exit 2; }
    adb shell $INPUT tap $xy ;;
  tapxy)
    # A tap by position on the screen in use. Use it instead of a raw adb input: the id of the second display changes at each start.
    need_front
    [ -n "$2" ] || { echo "pp: tapxy X Y" >&2; exit 1; }
    adb shell $INPUT tap "$1" "$2" ;;
  wait)
    end=$((SECONDS + ${2:-20}))
    while [ $SECONDS -lt $end ]; do
      dump | python3 "$HERE/../lib/find.py" has "$1" && exit 0
      sleep 1
    done
    echo "pp: timed out waiting for: $1" >&2; exit 3 ;;
  go)
    bash "$0" tap "$1" || exit $?
    bash "$0" wait "$2" "${3:-20}" ;;
  type)
    need_front
    if command -v termux-clipboard-set >/dev/null; then
      printf '%s' "$1" | termux-clipboard-set
      adb shell $INPUT keyevent 279 # KEYCODE_PASTE
    else
      # No termux-api here (the app's Linux system): the keyboard layer. Spaces need %s, and some characters are lost.
      echo "pp: no termux-api: typing through the keyboard" >&2
      adb shell $INPUT text "$(printf '%s' "$1" | sed 's/ /%s/g')"
    fi ;;
  key)
    need_front
    case "$1" in enter) k=66;; back) k=4;; del) k=67;; paste) k=279;; *) k=$1;; esac
    adb shell $INPUT keyevent "$k" ;;
  shot)
    need_front
    f=${1:-$OUT/shot.png}
    # A sleeping screen keeps the last frame: screencap then shows an old picture. Wake it and let it draw.
    if [ -n "$DISP" ]; then
      adb exec-out screencap -d "$SF" -p > "$f" || exit 1
      # A sleeping display gives a black picture (a few KB). Wake it, let it draw, and take the picture again.
      if [ "$(wc -c < "$f")" -lt 30000 ]; then
        adb shell "rm -f /data/local/tmp/pp-asleep; input -d $DISP keyevent KEYCODE_WAKEUP"; sleep 1.2
        adb exec-out screencap -d "$SF" -p > "$f"
      fi
      echo "$f"; exit
    fi
    adb shell input keyevent 224    # KEYCODE_WAKEUP
    sleep 0.6
    adb exec-out screencap -p > "$f" && echo "$f" ;;
  swipe)
    need_front
    adb shell $INPUT swipe "$@" ;;
  scroll)
    need_front
    case "$1" in up|down) scroll "$1" ;; *) echo "pp: scroll down|up" >&2; exit 1 ;; esac ;;
  find)
    need_front
    for _ in $(seq "${2:-8}"); do
      dump | python3 "$HERE/../lib/find.py" has "$1" && exit 0
      scroll down; sleep 0.5
    done
    dump | python3 "$HERE/../lib/find.py" has "$1" && exit 0
    echo "pp: no node after scrolling: $1" >&2; exit 2 ;;
  audit)
    need_front
    d=$(adb shell wm density | command grep -o '[0-9]*$' | tail -1)
    dump | python3 "$HERE/../lib/ui.py" audit "${d:-420}" ;;
  init) python3 "$HERE/../lib/init.py" ;;
  compare) python3 "$HERE/../lib/ui.py" compare "$1" "$2" ;;
  perf)
    case "${1:-show}" in
      start)
        adb shell dumpsys gfxinfo "$PKG" reset >/dev/null
        # A small log buffer (256 KiB on some phones) holds only seconds: make the main buffer 8 MB until the next phone start.
        adb logcat -b main -G 8M >/dev/null 2>&1
        adb shell "date '+%m-%d %H:%M:%S.000'" | tr -d '\r' > "$OUT/perf.since"
        echo "pp: frame stats reset" ;;
      show)
        adb shell dumpsys gfxinfo "$PKG" | command grep -E '^(Total frames rendered|Janky frames|[0-9]+th percentile|Number (Slow|Missed|High|Frame deadline))' | head -14
        since=$(cat "$OUT/perf.since" 2>/dev/null)
        pid=$(adb shell pidof "$PKG" | tr -d '\r')
        [ -n "$pid" ] && adb logcat -d -v brief ${since:+-T "$since"} --pid="$pid" -s Perf:* | command grep -v '^-----' | tail -40 ;;
      *) echo "pp perf start|show" >&2; exit 2 ;;
    esac ;;
  states)
    need_front
    f=${1:-$OUT/states.png}
    night=$(adb shell cmd uimode night | command grep -o 'yes\|no\|auto' | head -1)
    scale=$(adb shell settings get system font_scale)
    restore() { adb shell cmd uimode night "${night:-auto}" >/dev/null; adb shell settings put system font_scale "${scale:-1.0}" >/dev/null; }
    trap restore EXIT
    shots=""
    for s in "no 1.0" "yes 1.0" "no 2.0"; do
      set -- $s
      adb shell cmd uimode night "$1" >/dev/null
      adb shell settings put system font_scale "$2" >/dev/null
      sleep 2
      bash "$0" shot "$OUT/state-$1-$2.png" >/dev/null || exit $?
      shots="$shots $OUT/state-$1-$2.png"
    done
    python3 "$HERE/../lib/ui.py" sheet "$f" $shots ;;
  *) sed -n '2,17p' "$0"; exit 1 ;;
esac
